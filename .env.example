# Copie para .env.local (dev) e configure na Vercel (produção).
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_CHECKOUT_URL=            # [LINK_CHECKOUT] Kiwify/Hotmart/Eduzz
NEXT_PUBLIC_META_PIXEL_ID=           # [PIXEL_ID] vazio = pixel desligado
NEXT_PUBLIC_GA_ID=                   # opcional (G-XXXXXXX)
NEXT_PUBLIC_WHATSAPP=                # [WHATSAPP] só dígitos, ex: 5511999999999
NEXT_PUBLIC_CNPJ=                    # [CNPJ]
NEXT_PUBLIC_CONTACT_EMAIL=           # e-mail de suporte
NEXT_PUBLIC_REVIEWER_NAME=           # [NOME DO REVISOR]
NEXT_PUBLIC_REVIEWER_CREA=           # [REGISTRO CREA]
NEXT_PUBLIC_REVIEWER_BIO=            # [MINIBIO]
